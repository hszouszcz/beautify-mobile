# Beautify mobile — environment config.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time. After editing
# this file, restart Metro with cache cleared:  npx expo start --clear
#
# This base URL is the public API origin (non-secret). For local overrides that
# should NOT be committed, use .env.local (gitignored).
EXPO_PUBLIC_API_URL=https://api.beautify.local/api
